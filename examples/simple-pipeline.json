{
  "design": {
    "type": "design",
    "depends_on": [],
    "service_name": "myservice",
    "description": "设计 API：定义 /api/users 端点的请求/响应格式"
  },
  "backend": {
    "type": "backend",
    "depends_on": ["design"],
    "service_name": "myservice",
    "description": "实现 /api/users 端点",
    "agent_contract": {
      "inputs": ["design API specification"],
      "outputs": ["users endpoint implementation", "unit tests"],
      "responsibilities": ["preserve backward compatibility"],
      "exclusions": ["production deployment"],
      "permissions": ["repository:write", "test:run"],
      "context_budget": 12000
    },
    "completion_contract": {
      "required_artifacts": ["implementation"],
      "required_gates": ["unit-tests"]
    }
  },
  "test": {
    "type": "test",
    "depends_on": ["backend"],
    "service_name": "myservice",
    "description": "对 /api/users 做集成测试"
  }
}

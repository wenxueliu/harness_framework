{
  "implement-login": {
    "type": "backend",
    "service_name": "user-service",
    "depends_on": [],
    "description": "实现用户登录功能",
    "agent_contract": {
      "inputs": ["登录需求", "API 设计"],
      "outputs": ["实现", "评审报告"],
      "responsibilities": ["实现登录接口", "根据评审意见修订"],
      "exclusions": ["不得自行冒充独立 Reviewer"],
      "permissions": ["repo:write", "tests:run"],
      "context_budget": 20000
    },
    "context_inputs": [
      "summaries/login-requirement",
      "artifacts/login-api-design"
    ],
    "review_policy": {
      "max_rounds": 3,
      "dimensions": [
        "requirement-conformance",
        "correctness",
        "error-handling",
        "test-coverage"
      ],
      "blocking_severities": ["CRITICAL", "HIGH"],
      "require_independent_agent": true,
      "human_approval_after_pass": true
    },
    "completion_contract": {
      "required_artifacts": ["implementation", "review-report"],
      "required_gates": ["unit-tests", "review"]
    }
  }
}

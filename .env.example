# Harness Framework 环境变量配置示例
# 复制此文件为 .env 并填写实际值：
#   cp .env.example .env
#
# 配置优先级：命令行参数 > 环境变量 > .env 文件 > 默认值

# ── Consul 连接 ──────────────────────────────────────────────
# Consul HTTP 地址（默认 127.0.0.1:8500）
CONSUL_ADDR=127.0.0.1:8500
# ACL Token（dev mode 可省略）
# CONSUL_TOKEN=

# ── Agent 标识（stage-bridge / worker 使用）──────────────────
# 全局唯一 Agent ID，用于标识此 Agent 实例
# 必填，不可自动生成，必须由用户显式指定
AGENT_ID=

# ── 服务配置（stage-bridge / worker 使用）────────────────────
# 绑定的微服务名称（开发 Agent 必填）
# 必填，不可自动生成，必须由用户显式指定
SERVICE_NAME=

# 代码仓库本地路径
# 必填，不可自动生成，必须由用户显式指定
REPO_PATH=

# ── 需求/任务配置 ───────────────────────────────────────────
# 当前需求 ID（harness-sync / stage-bridge / design-pipeline 使用）
# REQ_ID=req-001

# 当前任务名称（stage-bridge 使用）
# TASK_NAME=implement-api

# ── Daemon 框架配置 ─────────────────────────────────────────
# 框架 HTTP 监听端口（默认 8080）
# PORT=8080

# Aggregator 轮询间隔秒数（默认 5）
# AGGREGATOR_INTERVAL=5

# Watchdog 轮询间隔秒数（默认 30）
# WATCHDOG_INTERVAL=30

# 单任务超时秒数（默认 3600）
# TASK_TIMEOUT=3600

# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
# LOG_LEVEL=INFO

# ── 本地模式配置 ────────────────────────────────────────────
# 纯文件模式数据文件路径（--local-file 模式使用）
# LOCAL_DATA_FILE=~/.harness/file_store.json

# 单机模式 Agent ID（--standalone 模式使用）
# STANDALONE_AGENT_ID=standalone-agent
